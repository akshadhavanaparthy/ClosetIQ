# ==============================================================================
# ClosetIQ Platform Configuration Example
# Copy this file to .env and adjust variables as required for your environment.
# Note: Do not commit actual secrets to version control.
# ==============================================================================

# Database (PostgreSQL)
# Used by Prisma ORM for relational persistence
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/closetiq?schema=public"

# Core API Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Authentication & Cryptographic Secrets (generate secure random strings for production)
JWT_ACCESS_SECRET="closetiq_dev_access_secret_change_in_production"
JWT_REFRESH_SECRET="closetiq_dev_refresh_secret_change_in_production"
COOKIE_DOMAIN="localhost"

# Python ML Vision & Geometry Microservice
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_API_KEY="closetiq_internal_ml_key_2026"

# Storage Service Provider (Options: MOCK | S3 | CLOUDINARY)
STORAGE_PROVIDER="MOCK"

# AI Reasoning & Editorial Styling Provider (Options: MOCK | ANTHROPIC | OPENAI | GEMINI)
AI_PROVIDER="MOCK"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Assets CDN
VITE_IMAGE_CDN_URL="https://images.unsplash.com"

# ML Microservice Specific Settings (for apps/ml-service)
# HOST="0.0.0.0"
# PORT=8000
# INTERNAL_API_KEY="closetiq_internal_ml_key_2026"
